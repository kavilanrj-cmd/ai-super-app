# =============================================================
# AI Super App - Environment Configuration
# Copy to `.env` for local development, or set these variables
# directly in your deployment platform (Vercel / Render / Neon).
# =============================================================

# ---------- App ----------
APP_NAME=AI Super App
APP_VERSION=1.0.0
# Set to false in production
DEBUG=False

# ---------- Database (Neon PostgreSQL) ----------
# Use the connection string from your Neon dashboard.
# Both `postgres://` and `postgresql://` schemes are accepted;
# the backend automatically uses the async driver (asyncpg).
DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@HOST:PORT/DB_NAME?sslmode=require

# Local development (SQLite) - uncomment for a quick start:
# DATABASE_URL=sqlite+aiosqlite:///./super_app.db

# ---------- Security ----------
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- AI Provider (Groq) ----------
# GROQ_MODEL: chat model used by ChatGroq / Groq SDK. Single source of truth.
# The application uses this value as the active model for all ChatGroq calls.
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_VISION_MODEL: multimodal (vision) model used by Image AI
# (describe / caption / OCR). Kept separate from GROQ_MODEL because the
# chat model is text-only. Set to a currently supported Groq vision model.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=

# ---------- AI Builder (local Ollama, no API token required) ----------
# AI App Builder runs against your local Ollama server (FastAPI -> Ollama,
# never browser -> Ollama). No OpenAI / Groq / Anthropic key is needed.
# Start Ollama (https://ollama.com) then pull the model you set below.
APP_BUILDER_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Must be installed locally, e.g.:  ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
# Generated projects are sandboxed under this dir (repo root).
APP_BUILDER_WORKSPACE_DIR=app_builder/projects
APP_BUILDER_PREVIEW_PORT_BASE=3100
APP_BUILDER_MAX_REPAIRS=3
# Keep App Builder fully local: set false to forbid cloud fallback when Ollama is down.
APP_BUILDER_GROQ_FALLBACK=false

# ---------- Job Finder (provider) ----------
# JOB_PROVIDER: "jsearch" (default, RapidAPI) or "adzuna".
# Credentials are read from the environment; never commit real keys.
JOB_PROVIDER=jsearch
# RapidAPI JSearch key -> https://rapidapi.com/rockthecode/api/jsearch
JSEARCH_API_KEY=
# Adzuna credentials -> https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---------- CORS / Frontend ----------
# The deployed frontend URL (Vercel). Added to CORS allow-list automatically.
FRONTEND_URL=https://your-frontend.vercel.app
# Comma-separated or JSON array of additional allowed origins.
# Note: development-only origins are stripped automatically when DEBUG=False.
CORS_ORIGINS=[]

# ---------- Frontend build environment (Vercel) ----------
# The deployed backend URL (Render). Must include the /api/v1 prefix.
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api/v1

# ---------- Optional integrations ----------
# Supabase (file storage)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-key

# AWS S3 (optional file storage)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_BUCKET_NAME=your-bucket-name
# AWS_REGION=us-east-1

# OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GITHUB_CLIENT_ID=your-github-client-id

# ---------- Admin account (seeded on first startup) ----------
ADMIN_EMAIL=admin@superapp.ai
ADMIN_PASSWORD=change-this-admin-password

# ---------- Redis / Celery (optional, for caching and background jobs) ----------
# REDIS_URL=redis://user:pass@host:port
# CELERY_BROKER_URL=redis://user:pass@host:port/0
